# API (apps/api)
MIB_PORT=3001
MIB_DATABASE_PATH=./data/mib.sqlite
# Enables dev sign-in, seeded users, the dev clock and /api/dev routes. Set to false for anything public.
MIB_DEV_MODE=true
MIB_LOG_REQUESTS=true
# Travel model (spec D01 is open): ms of travel per chart unit and a minimum journey length.
MIB_MS_PER_CHART_UNIT=3600000
MIB_MIN_JOURNEY_MS=21600000
# Destination shore slots (spec D06 is open).
MIB_DEFAULT_SHORE_CAPACITY=5
MIB_JOURNEY_TICK_MS=15000
MIB_CORS_ORIGIN=http://localhost:5173

# Web (apps/web): where the Vite dev server proxies /api
MIB_API_URL=http://localhost:3001

# Web map provider (optional). Leave unset to use the bundled, offline, credential-free
# Natural Earth land geometry. To use a licensed vector-tile provider, give a TileJSON URL and
# the name of its land/coastline source layer; only that layer is drawn (no labels, no borders).
# Never commit real keys: put them in apps/web/.env, which is git-ignored.
# VITE_MIB_MAP_TILES_URL=https://tiles.example.com/land/tiles.json?key=YOUR_KEY
# VITE_MIB_MAP_SOURCE_LAYER=land
# VITE_MIB_MAP_ATTRIBUTION=© Example Tiles
