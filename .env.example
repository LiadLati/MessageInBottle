# Copy to apps/api/.env (or a .env at the repository root) — the API loads both on start, and
# anything already set in the real environment wins over the file. Never commit a real .env.

# API (apps/api)
MIB_PORT=3001
MIB_DATABASE_PATH=./data/mib.sqlite
# Enables the seeded development accounts (dev-only password, see README), the dev clock and the
# /api/dev routes. Set to false for anything public.
MIB_DEV_MODE=true
# Sign-in token lifetime in ms (default 30 days).
# MIB_SESSION_TTL_MS=2592000000
MIB_LOG_REQUESTS=true
# Travel model (spec D01 is open): ms of travel per chart unit and a minimum journey length.
MIB_MS_PER_CHART_UNIT=3600000
MIB_MIN_JOURNEY_MS=21600000
# Destination shore slots (spec D06 is open).
MIB_DEFAULT_SHORE_CAPACITY=5
MIB_JOURNEY_TICK_MS=15000
MIB_CORS_ORIGIN=http://localhost:5173
# Set to true only behind a reverse proxy that sets X-Forwarded-For; sign-in and registration
# rate limits are then keyed by that address instead of the socket peer.
MIB_TRUST_PROXY=false

# Public URL of the web app, used for links in e-mails (password reset).
MIB_APP_URL=http://localhost:5173

# Outbound e-mail (password recovery). Provider-neutral: pick one of
#   outbox   development only — messages are captured in memory and listed in the dev bar and
#            GET /api/dev/outbox; refused when MIB_DEV_MODE=false (default in dev mode)
#   smtp     any SMTP provider (Postmark, SES, Mailgun, Gmail app passwords, a relay…)
#   disabled nothing is sent; the request-reset endpoint still answers normally (default in prod)
# Never commit real credentials: put them in apps/api/.env, which is git-ignored.
# Development default is `outbox`: NOTHING IS DELIVERED. To send real email, set `smtp` here and
# fill in the MIB_SMTP_* values below with credentials from your own provider.
MIB_MAIL_PROVIDER=outbox
MIB_MAIL_FROM="Message in a Bottle <no-reply@example.com>"
# MIB_SMTP_HOST=smtp.example.com
# MIB_SMTP_PORT=587
# MIB_SMTP_SECURE=false
# MIB_SMTP_USER=your-smtp-username
# MIB_SMTP_PASS=your-smtp-password

# Web (apps/web): where the Vite dev server proxies /api
MIB_API_URL=http://localhost:3001

# Web map provider (optional). Leave unset to use the bundled, offline, credential-free
# Natural Earth land geometry. To use a licensed vector-tile provider, give a TileJSON URL and
# the name of its land/coastline source layer; only that layer is drawn (no labels, no borders).
# Never commit real keys: put them in apps/web/.env, which is git-ignored.
# VITE_MIB_MAP_TILES_URL=https://tiles.example.com/land/tiles.json?key=YOUR_KEY
# VITE_MIB_MAP_SOURCE_LAYER=land
# VITE_MIB_MAP_ATTRIBUTION=© Example Tiles

# Journey rules (spec §9.3). The risk policy version stamped on new journeys: 3 = approved policy
# (nights are the sender's own, in the account's time zone), 0 = no automatic outcomes for new
# journeys. Never changes a journey already at sea. Each account's zone comes from its device.
MIB_RISK_POLICY_VERSION=3

# Local AI review of reported letters (spec §16). An Ollama-compatible endpoint on your own
# machine (default) or, later, a cloud host — a URL change, no paid API. While it is offline,
# reports stay queued and are retried. The model only ever sees the reported text.
MIB_AI_ENABLED=true
MIB_AI_ENDPOINT=http://127.0.0.1:11434
MIB_AI_MODEL=qwen2.5:7b
MIB_AI_TIMEOUT_MS=60000
MIB_AI_TICK_MS=10000
# false: the model's verdict is a recommendation shown to admins (default). true: a clear
# accept/reject decides the case; "uncertain" always goes to an admin. Enable only after
# `pnpm --filter @mib/api ai:eval` shows no dangerous disagreements with your model.
MIB_AI_AUTO_DECIDE=false

# Moderation evidence retention (spec §16). A case keeps a copy of the reported letter so that
# admins and appeals judge the same text. Nothing is ever removed until this is switched on,
# and even then only from cases where nothing can still need the text: never a pending report,
# never a pending or still-possible appeal, never a violation the account is still under.
# Leave these unset (the default) to keep evidence for ever. See docs/ARCHITECTURE.md for the
# recommended values and the two product decisions they depend on.
MIB_RETENTION_ENABLED=false
# Days after a report is REJECTED before its evidence may be cleared. Unset = never.
#MIB_RETENTION_REJECTED_DAYS=90
# Days after an accepted case stops mattering (violation revoked and appeals closed) before its
# evidence may be cleared. Unset = never. Inert unless MIB_APPEAL_WINDOW_DAYS is set too.
#MIB_RETENTION_ACCEPTED_DAYS=180
# Days a sender may appeal an accepted violation. Unset = no deadline (the current rule).
# A suspended or banned account may always appeal, whatever this says.
#MIB_APPEAL_WINDOW_DAYS=30


# The legal documents (Terms of Use, Community Rules, Privacy Policy, Child Safety Standards)
# are published from packages/shared/src/policies.ts at version 1.0. There is no environment
# switch for them: shipping a new version is a code change, and every account is then asked to
# accept it. See docs/LEGAL_DOCUMENTS.md.
