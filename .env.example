# Copy to apps/api/.env (or a .env at the repository root) — the API loads both on start, and
# anything already set in the real environment wins over the file. Never commit a real .env.

# API (apps/api)
MIB_PORT=3001
MIB_DATABASE_PATH=./data/mib.sqlite
# Development mode is OFF unless this is exactly `true`. `true` enables the seeded development
# accounts (dev-only password, see README), the dev clock and the /api/dev routes, which all
# require a signed-in `developer` account. Set it to true on your own machine only. It is refused
# in production (the compiled API, or NODE_ENV=production) and any value other than true/false
# stops the API. In production MIB_DATABASE_PATH must also be an absolute path.
MIB_DEV_MODE=false
# Sign-in token lifetime in ms (default 30 days).
# MIB_SESSION_TTL_MS=2592000000
MIB_LOG_REQUESTS=true
# Travel model (spec D01, settled by product decision 15: keep these values): ms of travel per
# chart unit and a minimum journey length. Same-harbour letters arrive immediately.
MIB_MS_PER_CHART_UNIT=3600000
MIB_MIN_JOURNEY_MS=21600000
# Bottles one account's shore holds at once — travelling to it plus delivered and unopened
# (product decision 8). Default 100; a full shore refuses new releases and keeps the draft.
# MIB_SHORE_CAPACITY=100
# Legacy per-shore capacity column written by the seed; it no longer limits anything.
MIB_DEFAULT_SHORE_CAPACITY=5
MIB_JOURNEY_TICK_MS=15000
MIB_CORS_ORIGIN=http://localhost:5173
# Set to true only behind a reverse proxy that sets X-Forwarded-For; sign-in and registration
# rate limits are then keyed by that address instead of the socket peer.
MIB_TRUST_PROXY=false
# How many trusted proxies append to X-Forwarded-For in front of the API (default 1). The client
# address is read that many entries from the RIGHT; entries further left are client-written.
# MIB_TRUSTED_PROXY_HOPS=1

# Public URL of the web app, used for links in e-mails (password reset). Must be https:// in
# production (the server refuses anything else); HSTS is sent when it is https.
MIB_APP_URL=http://localhost:5173

# Outbound e-mail (password recovery). Provider-neutral: pick one of
#   outbox   development only — messages are captured in memory and listed in the dev bar and
#            GET /api/dev/outbox (developer role only); refused unless MIB_DEV_MODE=true
#   smtp     any SMTP provider (Postmark, SES, Mailgun, Gmail app passwords, a relay…)
#   disabled nothing is sent; the request-reset endpoint still answers normally (default in prod)
# Never commit real credentials: put them in apps/api/.env, which is git-ignored.
# Default: `outbox` when MIB_DEV_MODE=true (NOTHING IS DELIVERED; a signed-in developer reads it
# in the dev bar), `disabled` otherwise. To send real email, set `smtp` here and fill in the
# MIB_SMTP_* values below with credentials from your own provider.
#
# SeaYou's production mailbox is seayou.support@gmail.com, sending through Gmail with an App
# Password (docs/DEPLOYMENT.md, "Password-reset email through Gmail"). The App Password is a
# secret: set MIB_SMTP_PASS only in the host's secret store or the git-ignored apps/api/.env —
# never here, in code, in tests, in logs or in Git.
# MIB_MAIL_PROVIDER=smtp
# MIB_MAIL_FROM="SeaYou <seayou.support@gmail.com>"
# MIB_SMTP_HOST=smtp.gmail.com
# MIB_SMTP_PORT=465
# MIB_SMTP_SECURE=true
# MIB_SMTP_USER=seayou.support@gmail.com
# MIB_SMTP_PASS=
MIB_MAIL_FROM="SeaYou <no-reply@example.com>"

# Web (apps/web): where the Vite dev server proxies /api
MIB_API_URL=http://localhost:3001

# Web map provider (optional). Leave unset to use the bundled, offline, credential-free
# Natural Earth land geometry. To use a licensed vector-tile provider, give a TileJSON URL and
# the name of its land/coastline source layer; only that layer is drawn (no labels, no borders).
# THIS KEY IS PUBLIC. Every VITE_* value is inlined into the JavaScript the browser downloads,
# so anyone who opens SeaYou can read it; keeping it out of git does not keep it secret. Use only
# a key the provider restricts to your domain (HTTP referrer / origin restriction), or serve the
# tiles through your own proxy. Keep it in apps/web/.env (git-ignored) anyway. (audit SEC-019)
# When a provider is configured, VITE_MIB_MAP_ATTRIBUTION is shown on the map, as its terms
# require.
# VITE_MIB_MAP_TILES_URL=https://tiles.example.com/land/tiles.json?key=YOUR_KEY
# VITE_MIB_MAP_SOURCE_LAYER=land
# VITE_MIB_MAP_ATTRIBUTION=© Example Tiles

# Journey rules (spec §9.3). The risk policy version stamped on new journeys: 4 = approved policy
# (one map clock per account: its devices' latest accepted IANA zone, else the harbour's, else
# UTC; a daytime map has no storm, each night entered rolls a 25% storm at most once per 24
# hours), 0 = no automatic outcomes for new journeys. There is no server-side zone setting.
MIB_RISK_POLICY_VERSION=4

# Local AI review of reported letters (spec §16). An Ollama-compatible endpoint on your own
# machine (default) or, later, a cloud host — a URL change, no paid API. While it is offline,
# reports stay queued and are retried. The model only ever sees the reported text.
MIB_AI_ENABLED=true
MIB_AI_ENDPOINT=http://127.0.0.1:11434
MIB_AI_MODEL=qwen2.5:7b
MIB_AI_TIMEOUT_MS=60000
MIB_AI_TICK_MS=10000
# The model only recommends (product decision 2): every case is decided by a person, and a
# possible child-safety issue it flags only marks the case urgent. MIB_AI_AUTO_DECIDE was
# removed; setting it to true stops the API.

# Moderation evidence retention (spec §16.5). A case keeps a copy of the reported letter so
# that administrators and appeals judge the same text. The copy, reporters' explanations and
# the AI translation and notes are redacted 30 days after the administrator's decision — the
# appeal window — or once an appeal filed in time is decided, whichever is later. Undecided
# reports keep their evidence; an unopened notice does not. A documented legal or child-safety
# hold keeps it longer. This runs by default: the settings below are for a staging environment.
#
# false stops it removing anything (the dry-run plan still works):
#MIB_RETENTION_ENABLED=false
# A shorter or longer window than the published 30 days. Ordinary deployments leave it unset.
#MIB_RETENTION_DAYS=30
# How often the server checks for cases that have passed the window. Hourly by default.
#MIB_RETENTION_TICK_MS=3600000


# The legal documents (Terms of Use, Community Rules, Privacy Policy, Child Safety Standards)
# are published from packages/shared/src/policies.ts at version 1.1. There is no environment
# switch for them: shipping a new version is a code change, and every account is then asked to
# accept it. See docs/LEGAL_DOCUMENTS.md.

# The public support contact shown on /support and named in the Privacy Policy and Child Safety
# Standards. It is a published address, not a secret, and support is a mailto: link only. The
# same mailbox sends password-reset email when SMTP is configured; its App Password is then a
# deployment secret (MIB_SMTP_PASS above), never part of this file.
# Override it in production to route support elsewhere.
MIB_SUPPORT_EMAIL=seayou.support@gmail.com
