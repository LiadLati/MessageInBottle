# Reference reverse-proxy configuration for SeaYou (Caddy 2). Provider-neutral: any proxy that
# does the same is fine. Replace seayou.example with the real domain. Caddy obtains and renews
# the TLS certificate and redirects http:// to https:// on its own.
seayou.example {
	# SeaYou's interface is the Android app (docs/ANDROID.md); no web app is published. The API
	# owns every path that exists: the API itself and the public pages a store listing, a
	# reset e-mail or a support reply links to.
	@api path /api/* /legal /legal/* /support /reset-password
	handle @api {
		request_body {
			max_size 64KB
		}
		# Caddy appends the client address to X-Forwarded-For: one trusted hop.
		reverse_proxy 127.0.0.1:3001
	}

	# The bare domain leads to support, which links to the legal pages; nothing else exists.
	handle / {
		redir /support 302
	}
	handle {
		respond "Not found" 404
	}
}
