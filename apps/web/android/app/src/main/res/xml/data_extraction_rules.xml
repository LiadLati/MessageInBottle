<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing SeaYou keeps on the device is backed up to the cloud or copied to a new device: the
     Privacy Policy promises that the session and the account's time zone are removed on
     sign-out, which a backup restored elsewhere would break. The account itself is on the
     server; signing in on a new device restores everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
