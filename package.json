{
  "name": "message-in-a-bottle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Message in a Bottle — slow correspondence between friends (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @mib/api --filter @mib/web dev",
    "dev:api": "pnpm --filter @mib/api dev",
    "dev:web": "pnpm --filter @mib/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @mib/api db:migrate",
    "db:seed": "pnpm --filter @mib/api db:seed",
    "db:reset": "pnpm --filter @mib/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
